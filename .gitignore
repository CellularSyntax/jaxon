# --- Python bytecode / caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Notebook crud ---
.ipynb_checkpoints/

# --- Virtual environments ---
venv/
.venv/
env/
.conda/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- NEURON-compiled mod artefacts (these are platform-specific; regenerate
#     with `pyfibers_compile` after installing on a new host) ---
x86_64/
arm64/
*.dylib
*.dll
*.so

# --- Run outputs (validation JSONs, figures, scaling data, selectivity
#     sweeps).  These are regenerable from code + pinned env; PNGs do not
#     diff well in git and large sweeps would balloon the repo.  Provenance
#     is preserved by commit hash; headline numbers live in AUDIT.md /
#     CHANGELOG.md as plain text. ---
outputs/
*.tmp

# --- SLURM job logs (slurm/submit_all.sh writes to logs/) ---
logs/
*.log

# --- Profiling / coverage artefacts ---
*.prof
.coverage
htmlcov/

# --- Editor backups / merge debris ---
*.bak
*.orig
*~

# --- Cloned upstream code lives in reference_code/ but ignore its
#     build artefacts ---
reference_code/**/__pycache__/
reference_code/**/*.egg-info/
reference_code/**/x86_64/
reference_code/**/arm64/
